# Copy this file to .env and fill in your local secrets.

# Azure Speech Service
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
DS_API_KEY=
# Optional fallback name for the same DeepSeek key:
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
